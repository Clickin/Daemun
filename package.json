{
  "name": "daemun",
  "version": "1.14.5",
  "private": true,
  "scripts": {
    "dev": "node src/server/dev.ts",
    "bench:containers": "node tools/bench/compare-containers.mjs",
    "build": "vite build && vite build --ssr",
    "docs:build": "pnpm --filter @daemun/docs build",
    "docs:assets": "node tools/generate-daemun-doc-assets.mjs",
    "docs:assets:raster": "node tools/generate-daemun-doc-assets.mjs --raster",
    "docs:audit-assets": "node tools/docs/audit-doc-assets.mjs",
    "docs:audit-links": "node tools/docs/audit-doc-links.mjs",
    "docs:dev": "pnpm --filter @daemun/docs dev",
    "docs:normalize-links": "node tools/docs/normalize-starlight-links.mjs",
    "docs:preview": "pnpm --filter @daemun/docs preview",
    "start": "node dist/server/index.mjs",
    "icons:generate": "node tools/generate-daemun-icons.mjs",
    "icons:raster": "node tools/generate-daemun-icons.mjs --raster",
    "format": "oxfmt",
    "gate:real-world:quick": "node tools/release-gate/run-real-world-gate.mjs --mode=quick",
    "gate:real-world:soak": "node tools/release-gate/run-real-world-gate.mjs --mode=soak",
    "gate:docs-parity": "node tools/release-gate/verify-docs-parity.mjs",
    "gate:client-lazy": "node tools/release-gate/verify-client-lazy.mjs",
    "gate:release": "pnpm build && pnpm gate:client-lazy && pnpm docs:build && pnpm docs:audit-assets && pnpm docs:audit-links && pnpm gate:upstream-contracts && pnpm gate:widgets && pnpm gate:docs-parity && pnpm gate:real-world:quick",
    "gate:upstream-contracts": "node tools/release-gate/verify-upstream-contracts.mjs",
    "gate:widgets": "node tools/release-gate/verify-widget-registry.mjs",
    "lint": "oxlint --quiet --react-plugin --jsx-a11y-plugin --vitest-plugin -D no-explicit-any src test tools vite.config.mjs vitest.config.mjs vitest.setup.mjs docs-site/astro.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cacheable/memory": "^2.0.8",
    "@headlessui/react": "^2.2.10",
    "@hono/node-server": "^2.0.2",
    "@kubernetes/client-node": "^1.0.0",
    "@logtape/file": "^2.0.7",
    "@logtape/logtape": "^2.0.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.20",
    "dockerode": "^4.0.10",
    "follow-redirects": "^1.16.0",
    "gamedig": "^5.3.2",
    "hono": "^4.12.18",
    "i18next": "^25.10.9",
    "ical.js": "^2.2.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "json-rpc-2.0": "^1.7.1",
    "minecraftstatuspinger": "^1.2.2",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.30.0",
    "ping": "^0.4.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^15.5.3",
    "react-icons": "^5.6.0",
    "systeminformation": "^5.31.6",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "tough-cookie": "^6.0.0",
    "txml": "^6.0.0",
    "typescript": "^6.0.3",
    "urbackup-server-api": "^0.92.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "osx-temperature-sensor": "^1.0.8"
  },
  "packageManager": "pnpm@11.1.1"
}
