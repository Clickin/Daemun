# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:26.12.1-alpine3.23
FROM ${NODE_IMAGE} AS runner
ARG NODE_IMAGE
RUN case "$NODE_IMAGE" in platformatic/node-caged:*) \
      node -e "const assert = require('node:assert/strict'); const [major, minor, patch] = process.versions.node.split('.').map(Number); assert(major > 26 || (major === 26 && (minor > 12 || (minor === 12 && patch >= 1))), 'node-caged requires Node.js >=26.12.1'); assert.equal(Number(process.config.variables.v8_enable_pointer_compression), 1, 'node-caged requires V8 pointer compression'); console.log('Verified node-caged', process.version)"; \
    esac

LABEL org.opencontainers.image.title="Daemun"
LABEL org.opencontainers.image.description="A static-first self-hosted dashboard with a localhost-only Hono API backend."
LABEL org.opencontainers.image.url="https://github.com/Clickin/Daemun"
LABEL org.opencontainers.image.documentation="https://github.com/Clickin/Daemun"
LABEL org.opencontainers.image.source="https://github.com/Clickin/Daemun"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"

WORKDIR /app

COPY runtime-deps/package.json ./runtime-deps/package.json
RUN node -e "const p = require('./runtime-deps/package.json'); const deps = { ...(p.dependencies || {}), ...(p.optionalDependencies || {}) }; if (Object.keys(deps).length) { console.error('CI Dockerfile requires empty runtime-deps; build the standard Dockerfile when runtime dependencies exist'); process.exit(1) }" \
  && mkdir node_modules

COPY --link --chown=1000:1000 dist ./dist
COPY --link --chown=1000:0 package.json ./package.json
COPY --link --chown=1000:1000 public ./public
COPY --link --chown=1000:1000 src/skeleton ./src/skeleton

RUN apk add --no-cache nginx su-exec iputils-ping shadow \
  && nginx -v \
  && mkdir -p /run/nginx /var/lib/nginx/tmp

COPY --link nginx-docker/nginx.conf /etc/nginx/nginx.conf
RUN nginx -t
COPY --link --chmod=755 nginx-docker/entrypoint.sh /usr/local/bin/daemun-nginx-entrypoint

USER root
ENV NODE_ENV=production
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s \
  CMD wget --no-verbose --tries=1 --spider -Y off http://127.0.0.1/api/healthcheck || exit 1

ENTRYPOINT ["daemun-nginx-entrypoint"]
